# JANSEVA - Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note: The platform includes a seamless local-fallback database engine with real seed data
# so you can explore, test, and demonstrate 100% of the functionality even before configuring live credentials.
